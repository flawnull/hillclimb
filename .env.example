# Val Borbera Hillclimb Environment Variables

# Upstash Redis for Leaderboards & Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Secret for HMAC run token signing (min 32 characters)
RUN_SECRET=change_this_to_a_secure_random_32_char_secret_key
