# Val Borbera Hillclimb — environment variables
#
# All three are REQUIRED in production. The app fails loudly if any is missing rather than
# degrading silently, so a misconfigured deployment is obvious immediately.
# In development they are optional: Redis falls back to an in-memory mock and the run-token
# secret falls back to a development default.

# Upstash Redis — leaderboards and rate limiting.
# Free tier at https://upstash.com is sufficient (10k commands/day).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# HMAC key for signing run tokens. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Do NOT deploy with the development fallback baked into src/lib/runToken.ts — it is a
# literal in a public repository, so anyone could mint valid tokens and post forged times.
RUN_SECRET=generate_a_random_48_byte_value_do_not_reuse_this_line
